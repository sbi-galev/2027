---
// 1-bit dithered spiral galaxy, slowly rotating. Static under prefers-reduced-motion.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<canvas class:list={['galaxy', className]} aria-hidden="true"></canvas>

<script>
  const PX = 2; // CSS pixels per dither pixel
  const COS_I = 0.42; // inclination
  const PA = -0.38; // position angle (rad)
  const K = 3.6; // 1 / tan(pitch)
  const OMEGA = (2 * Math.PI) / 150; // rad/s
  const FPS = 20;

  const hash = (x: number, y: number) => {
    let h = Math.imul(x, 374761393) + Math.imul(y, 668265263);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };

  const noise = (x: number, y: number) => {
    const ix = Math.floor(x), iy = Math.floor(y);
    const fx = x - ix, fy = y - iy;
    const sx = fx * fx * (3 - 2 * fx), sy = fy * fy * (3 - 2 * fy);
    const a = hash(ix, iy), b = hash(ix + 1, iy);
    const c = hash(ix, iy + 1), d = hash(ix + 1, iy + 1);
    return a + (b - a) * sx + (c - a) * sy + (a - b - c + d) * sx * sy;
  };

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0;
    let img: ImageData, buf: Uint32Array;
    let gx: Float32Array, gy: Float32Array, lnR: Float32Array, th: Float32Array;
    let bulge: Float32Array, disk: Float32Array, thr: Float32Array;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      W = Math.max(48, Math.round(rect.width / PX));
      H = Math.max(48, Math.round(rect.height / PX));
      canvas.width = W;
      canvas.height = H;
      img = ctx.createImageData(W, H);
      buf = new Uint32Array(img.data.buffer);
      const n = W * H;
      gx = new Float32Array(n); gy = new Float32Array(n);
      lnR = new Float32Array(n); th = new Float32Array(n);
      bulge = new Float32Array(n); disk = new Float32Array(n);
      thr = new Float32Array(n);
      const S = Math.min(W / 2, H / COS_I / 2) * 0.98;
      const cp = Math.cos(PA), sp = Math.sin(PA);
      for (let y = 0, i = 0; y < H; y++) {
        for (let x = 0; x < W; x++, i++) {
          const dx = (x - W / 2) / S, dy = (y - H / 2) / S;
          const xr = dx * cp + dy * sp, yr = (-dx * sp + dy * cp);
          const u = xr, v = yr / COS_I; // deprojected disk plane
          const R = Math.hypot(u, v) + 1e-4;
          gx[i] = u; gy[i] = v;
          lnR[i] = Math.log(R);
          th[i] = Math.atan2(v, u);
          const rs = Math.hypot(xr, yr / 0.75);
          bulge[i] = 3 * Math.exp(-Math.pow(rs / 0.085, 0.9));
          disk[i] = Math.exp(-R / 0.3) * Math.min(1, Math.max(0, (1 - R) / 0.3));
          // interleaved gradient noise threshold: stable, blue-ish dither
          thr[i] = ((52.9829189 * ((0.06711056 * x + 0.00583715 * y) % 1)) % 1);
        }
      }
    }

    function draw(t: number, gain: number) {
      const phi = t * OMEGA;
      const c = Math.cos(phi), s = Math.sin(phi);
      for (let i = 0; i < buf.length; i++) {
        const d = disk[i];
        let b = bulge[i];
        if (d > 0.002) {
          const arm = 0.5 + 0.5 * Math.cos(2 * (th[i] - phi + K * lnR[i]));
          const a2 = arm * arm, a6 = a2 * a2 * a2;
          // knots that co-rotate with the disk
          const u = gx[i] * c + gy[i] * s, v = -gx[i] * s + gy[i] * c;
          const k = noise(u * 16 + 50, v * 16 + 50);
          b += d * (0.1 + 3.2 * a6 * (0.55 + 0.9 * k));
        }
        const L = 1 - Math.exp(-b * gain * 1.4);
        buf[i] = L > thr[i] ? 0xffffffff : 0;
      }
      ctx.putImageData(img, 0, 0);
    }

    resize();
    const t0 = performance.now();
    if (still) {
      draw(4, 1);
      new ResizeObserver(() => { resize(); draw(4, 1); }).observe(canvas);
      return;
    }

    let last = 0, raf = 0;
    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < 1000 / FPS) return;
      last = now;
      const t = (now - t0) / 1000;
      draw(t, Math.min(1, t / 1.8)); // develops in over ~2 s
    };
    // only animate while on screen
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      if (e.isIntersecting) raf = requestAnimationFrame(loop);
    }).observe(canvas);
    new ResizeObserver(() => resize()).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.galaxy').forEach(init);
</script>

<style>
  .galaxy {
    display: block;
    image-rendering: pixelated;
  }
</style>
